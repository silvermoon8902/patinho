# PostgreSQL
POSTGRES_USER=patinho
POSTGRES_PASSWORD=changeme
POSTGRES_DB=patinho
DATABASE_URL=postgresql+asyncpg://patinho:changeme@db:5432/patinho

# Application
SECRET_KEY=changeme-run-openssl-rand-hex-32
ENVIRONMENT=development
DEBUG=true

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxx
MERCADO_PAGO_WEBHOOK_SECRET=xxx
MERCADO_PAGO_PIX_KEY=xxx

# API Football
API_FOOTBALL_KEY=xxx

# Flower (Celery monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=changeme

# Email (SendGrid/SES/Mailgun SMTP compatible)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@patinho.com.br
SMTP_FROM_NAME=Patinho
SMTP_USE_TLS=true
APP_URL=https://patinho.com.br

# Terms versioning — bumped when ToS/Privacy changes
TERMS_VERSION=v1

# Error monitoring (optional — empty keeps Sentry disabled)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Frontend (Vite — build time)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
# VITE_SENTRY_DSN=  # only set when @sentry/react is installed
