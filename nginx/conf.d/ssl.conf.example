# Patinho HTTPS scaffold.
#
# Enable steps (run on VPS once a domain is pointed at the server):
#   1. Install certbot & obtain cert:
#        docker run -it --rm --name certbot \
#          -v "/etc/letsencrypt:/etc/letsencrypt" \
#          -v "/var/www/certbot:/var/www/certbot" \
#          -p 80:80 certbot/certbot certonly --standalone \
#          -d patinho.example.com
#      Or use the certbot service below (recommended).
#   2. Replace `patinho.example.com` in this file with the real host.
#   3. Rename this file to ssl.conf (drop `.example`).
#   4. Comment out the plain-HTTP `listen 80` server block in default.conf
#      (or replace it with the HTTP→HTTPS redirect below).
#   5. `docker compose exec nginx nginx -s reload`

# HTTP → HTTPS redirect (enable after cert is in place)
# server {
#     listen 80;
#     server_name patinho.example.com;
#     location /.well-known/acme-challenge/ {
#         root /var/www/certbot;
#     }
#     location / {
#         return 301 https://$host$request_uri;
#     }
# }

# server {
#     listen 443 ssl http2;
#     server_name patinho.example.com;
#
#     ssl_certificate     /etc/letsencrypt/live/patinho.example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/patinho.example.com/privkey.pem;
#
#     # Modern TLS config (Mozilla "intermediate", 2024)
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_prefer_server_ciphers off;
#     ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
#     ssl_session_cache shared:SSL:10m;
#     ssl_session_timeout 1d;
#     ssl_session_tickets off;
#
#     # Security headers (HSTS enabled ONLY once HTTPS is confirmed working —
#     # once browsers cache HSTS, you can't roll back without breaking clients)
#     add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
#     add_header X-Frame-Options "SAMEORIGIN" always;
#     add_header X-Content-Type-Options "nosniff" always;
#     add_header X-XSS-Protection "1; mode=block" always;
#     add_header Referrer-Policy "strict-origin-when-cross-origin" always;
#
#     # Reuse the same upstream/location rules from default.conf.
#     # Copy the `location /api/v1/auth/`, `/api/v1/payments/webhook/`,
#     # `/api/`, `/ws/`, `/media/`, and `/` blocks from default.conf here.
# }
